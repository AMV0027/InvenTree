{
  "name": "inventree-node-hono",
  "version": "1.0.0",
  "description": "InvenTree backend rewritten in Node.js using Hono and Prisma ORM",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.633.0",
    "@hono/node-server": "^1.12.0",
    "@prisma/client": "^5.18.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "hono": "^4.5.8",
    "ioredis": "^5.4.1",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1"
  }
}
